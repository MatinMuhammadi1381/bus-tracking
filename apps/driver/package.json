    "bus-tracking-gps-plugin": "file:src/native/android",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@bus-tracking/shared-types": "workspace:*",
    "@bus-tracking/validation": "workspace:*",
    "@bus-tracking/api-contracts": "workspace:*",
    "@bus-tracking/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "tailwindcss": "^3.4.0",
