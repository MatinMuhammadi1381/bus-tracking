import { useState, useEffect } from 'react';

interface PastTrip {
  id: string;
  origin: string;
  destination: string;
  date: string;
  status: 'COMPLETED' | 'CANCELLED';
  passengerCount: number;
  duration: string;
  bus: string;
  expectedPassengerCount: number;
  confirmedPassengerCount: number;
  startedAt: string;
  completedAt: string | null;
  activeDriverName: string;
  handovers: number;
  distanceKm: number;
  averageSpeedKmh: number;
  handoverDetails?: {
    from: string;
    to: string;
    time: string;
  }[];
}

interface TripHistoryScreenProps {
  // Future: connect to API
}

export function TripHistoryScreen() {
  const [trips, setTrips] = useState<PastTrip[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [selectedTrip, setSelectedTrip] = useState<PastTrip | null>(null);

  useEffect(() => {
    const fetchTrips = async () => {
      setLoading(true);
      try {
        await new Promise(resolve => setTimeout(resolve, 500));
        setTrips([
          {
            id: 'trip-001',
            origin: 'تهران',
            destination: 'مشهد',
            date: '۱۴۰۳/۰۶/۱۵',
            status: 'COMPLETED',
            passengerCount: 32,
            expectedPassengerCount: 32,
            confirmedPassengerCount: 32,
            duration: '۸ ساعت ۳۰ دقیقه',
            bus: 'اتوبوس اسکانیا - پلاک ۱۲۳۴۵۶۷۸',
            startedAt: '۱۴۰۳/۰۶/۱۵ ۰۶:۳۰',
            completedAt: '۱۴۰۳/۰۶/۱۵ ۱۵:۰۰',
            activeDriverName: 'احمد محمدی',
            handovers: 1,
            distanceKm: 892,
            averageSpeedKmh: 85,
            handoverDetails: [
              { from: 'احمد محمدی', to: 'علی رضایی', time: '۱۴۰۳/۰۶/۱۵ ۱۱:۱۵' },
            ],
          },
          {
            id: 'trip-002',
            origin: 'مشهد',
            destination: 'تهران',
            date: '۱۴۰۳/۰۶/۱۴',
            status: 'COMPLETED',
            passengerCount: 28,
            expectedPassengerCount: 30,
            confirmedPassengerCount: 28,
            duration: '۸ ساعت ۱۵ دقیقه',
            bus: 'اتوبوس مان - پلاک ۸۷۶۵۴۳۲۱',
            startedAt: '۱۴۰۳/۰۶/۱۴ ۰۶:۴۵',
            completedAt: '۱۴۰۳/۰۶/۱۴ ۱۵:۰۰',
            activeDriverName: 'علی رضایی',
            handovers: 0,
            distanceKm: 892,
            averageSpeedKmh: 82,
          },
          {
            id: 'trip-003',
            origin: 'تهران',
            destination: 'اصفهان',
            date: '۱۴۰۳/۰۶/۱۰',
            status: 'COMPLETED',
            passengerCount: 40,
            expectedPassengerCount: 40,
            confirmedPassengerCount: 40,
            duration: '۴ ساعت ۴۵ دقیقه',
            bus: 'اتوبوس ولوا - پلاک ۱۱۲۲۳۳۴۴',
            startedAt: '۱۴۰۳/۰۶/۱۰ ۰۷:۰۰',
            completedAt: '۱۴۰۳/۰۶/۱۰ ۱۱:۴۵',
            activeDriverName: 'حسن کریمی',
            handovers: 0,
            distanceKm: 438,
            averageSpeedKmh: 92,
          },
        ]);
      } catch (err) {
        setError('خطا در بارگذاری تاریخچه سفرها');
      } finally {
        setLoading(false);
      }
    };

    fetchTrips();
  }, []);

  const handleViewDetails = (trip: PastTrip) => {
    setSelectedTrip(trip);
  };

  const handleCloseDetails = () => {
    setSelectedTrip(null);
  };

  const formatStatus = (status: PastTrip['status']) => {
    return status === 'COMPLETED'
      ? { label: 'تکمیل شده', color: 'bg-green-100 text-green-800' }
      : { label: 'لغو شده', color: 'bg-red-100 text-red-800' };
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="animate-spin rounded-full h-12 w-12 border-4 border-primary-600 border-t-transparent"></div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-center">
        {error}
      </div>
    );
  }

  const renderDetails = () => {
    if (!selectedTrip) {
      return null;
    }

    return (
      <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div className="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <div className="p-6 border-b border-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-xl font-bold text-gray-900">جزئیات سفر</h2>
              <button
                onClick={handleCloseDetails}
                className="text-gray-400 hover:text-gray-600 text-2xl leading-none"
              >
                ×
              </button>
            </div>
          </div>
          <div className="p-6 space-y-6 max-h-[70vh] overflow-y-auto">
            <div className="flex items-center justify-between">
              <h3 className="text-lg font-semibold text-gray-900">
                {selectedTrip.origin} → {selectedTrip.destination}
              </h3>
              <span
                className={`px-3 py-1 rounded-full text-sm font-medium ${
                  selectedTrip.status === 'COMPLETED'
                    ? 'bg-green-100 text-green-800'
                    : 'bg-red-100 text-red-800'
                }`}
              >
                {selectedTrip.status === 'COMPLETED' ? 'تکمیل شده' : 'لغو شده'}
              </span>
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <p className="text-sm text-gray-500">تاریخ</p>
                <p className="font-medium text-gray-900">{selectedTrip.date}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">اتوبوس</p>
                <p className="font-medium text-gray-900">{selectedTrip.bus}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">شروع سفر</p>
                <p className="font-medium text-gray-900">{selectedTrip.startedAt}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">پایان سفر</p>
                <p className="font-medium text-gray-900">{selectedTrip.completedAt || '—'}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">راننده</p>
                <p className="font-medium text-gray-900">{selectedTrip.activeDriverName}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">تغییر راننده</p>
                <p className="font-medium text-gray-900">{selectedTrip.handovers} بار</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">فاصله</p>
                <p className="font-medium text-gray-900">{selectedTrip.distanceKm} کیلومتر</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">میانگین سرعت</p>
                <p className="font-medium text-gray-900">{selectedTrip.averageSpeedKmh} کیلومتر/ساعت</p>
              </div>
              <div className="col-span-2">
                <p className="text-sm text-gray-500">مسافران</p>
                <p className="font-medium text-gray-900">
                  {selectedTrip.confirmedPassengerCount} از {selectedTrip.expectedPassengerCount} نفر
                </p>
              </div>
              <div className="col-span-2">
                <p className="text-sm text-gray-500">مدت سفر</p>
                <p className="font-medium text-gray-900">{selectedTrip.duration}</p>
              </div>
            </div>

            {selectedTrip.handoverDetails && selectedTrip.handoverDetails.length > 0 && (
              <div className="border-t border-gray-200 pt-4">
                <h3 className="text-lg font-semibold text-gray-900 mb-3">تغییرات راننده</h3>
                <div className="space-y-2">
                  {selectedTrip.handoverDetails.map((handover, index) => (
                    <div key={index} className="bg-gray-50 rounded-lg p-3">
                      <div className="flex items-center space-x-2 rtl:space-x-reverse text-sm">
                        <span className="text-gray-500">از:</span>
                        <span className="font-medium text-gray-900">{handover.from}</span>
                        <span className="text-gray-400">→</span>
                        <span className="font-medium text-primary-700">{handover.to}</span>
                        <span className="text-gray-400 ml-auto">{handover.time}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <button
              onClick={handleCloseDetails}
              className="w-full mt-6 bg-primary-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-primary-700 focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-colors"
            >
              بستن
            </button>
          </div>
        </div>
      )
    );
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="animate-spin rounded-full h-12 w-12 border-4 border-primary-600 border-t-transparent"></div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-center">
        {error}
      </div>
    );
  }

  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <h2 className="text-xl font-bold text-gray-900">تاریچه سفرها</h2>
      </div>

      {error && (
        <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-center">
          {error}
        </div>
      )}

      {selectedTrip ? renderDetails() : (
        <div className="space-y-4">
          {error && (
            <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-center">
              {error}
            </div>
          )}

          {trips.length === 0 ? (
            <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
              <div className="text-6xl mb-4">📋</div>
              <h3 className="text-lg font-medium text-gray-900 mb-2">سفری ثبت نشده است</h3>
              <p className="text-gray-500">سفرهای گذشته شما اینجا نمایش داده می‌شوند</p>
            </div>
          ) : (
            <div className="space-y-3">
              {trips.map(trip => {
                const { label: statusLabel, color: statusColor } =
                  trip.status === 'COMPLETED'
                    ? { label: 'تکمیل شده', color: 'bg-green-100 text-green-800' }
                    : { label: 'لغو شده', color: 'bg-red-100 text-red-800' };

                return (
                  <div
                    key={trip.id}
                    className="bg-white rounded-xl shadow-sm border border-gray-200 p-4"
                  >
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <div className="flex items-center space-x-2 rtl:space-x-reverse mb-2">
                          <h3 className="text-lg font-semibold text-gray-900">
                            {trip.origin} → {trip.destination}
                          </h3>
                          <span
                            className={`px-2 py-1 rounded-full text-xs font-medium ${statusColor}`}
                          >
                            {statusLabel}
                          </span>
                        </div>
                        <div className="grid grid-cols-2 gap-2 text-sm text-gray-600 mb-3">
                          <p>
                            <span className="font-medium text-gray-900">تاریخ:</span> {trip.date}
                          </p>
                          <p>
                            <span className="font-medium text-gray-900">اتوبوس:</span> {trip.bus}
                          </p>
                          <p>
                            <span className="font-medium text-gray-900">مسافران:</span>{' '}
                            {trip.confirmedPassengerCount}/{trip.expectedPassengerCount} نفر
                          </p>
                          <p>
                            <span className="font-medium text-gray-900">مدت:</span> {trip.duration}
                          </p>
                          <p>
                            <span className="font-medium text-gray-900">فاصله:</span>{' '}
                            {trip.distanceKm} کیلومتر
                          </p>
                          <p>
                            <span className="font-medium text-gray-900">میانگین سرعت:</span>{' '}
                            {trip.averageSpeedKmh} کیلومتر/ساعت
                          </p>
                        </div>
                        {trip.handoverDetails && trip.handoverDetails.length > 0 && (
                          <p className="text-xs text-gray-500">
                            {trip.handoverDetails.length} تغییر راننده
                          </p>
                        )}
                      </div>
                      <button
                        onClick={() => handleViewDetails(trip)}
                        className="text-primary-600 hover:text-primary-700 text-sm font-medium ml-4"
                      >
                        جزئیات
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    );
  }
}