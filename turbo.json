{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:integration": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:e2e": {
      "outputs": ["playwright-report/**"],
      "dependsOn": []
    },
    "db:generate": {
      "outputs": ["node_modules/.prisma/client/**"]
    },
    "db:push": {
      "outputs": []
    },
    "db:migrate": {
      "outputs": []
    },
    "db:studio": {
      "cache": false
    }
  },
  "globalDependencies": [".env*"]
}
